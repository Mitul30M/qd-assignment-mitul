# Copy to .env and fill in. Never commit .env.

# --- Service ---
APP_PORT=8000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://qd:qd@postgres:5432/qd

# --- PaySwift (sandbox provided in docker-compose.yml) ---
PAYSWIFT_BASE_URL=http://payswift:8081

# --- LLM provider ---
# provider: groq | gemini | openai-compatible | stub
# Use stub for a deterministic local/CI run; replace with groq only when adding a key.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b  # llama-3.3-70b-versatile was retired by Groq; pick per your account
LLM_BASE_URL=
# Fallback provider used when the primary fails (optional; empty = template fallback)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# LLM call timeout seconds (<= 4) and max calls per message
LLM_TIMEOUT_S=3.5
LLM_MAX_CALLS=2

# --- PaySwift client tuning ---
PAYSWIFT_TIMEOUT_S=5
PAYSWIFT_MAX_RETRIES=3

# --- Ops console ---
# Optional shared token for /ops endpoints (Authorization: Bearer <token> or ?token=).
# Empty = unauthenticated local ops console (documented scope decision in README).
OPS_TOKEN=
